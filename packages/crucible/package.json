			"types": "./out/server/index.d.ts",
			"default": "./out/server/init.luau"
		},
		"./emit": {
			"types": "./out/emit/index.d.ts",
			"default": "./out/emit/init.luau"
		},
		"./client": {
			"types": "./out/client/index.d.ts",
