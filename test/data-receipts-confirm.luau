	["rule 34 and 63 a receipt save outranks ordinary work, so a purchase lands while ordinary sends are stalled"] = function()
		local backend, a = D2.world()
		D2.join(backend, a)
		D2.route(a, PRODUCT, 25)
		local decl = D2.message("grant")
		for index = 1, 3 do
			backend:fail("stall", { server = a.id, key = tostring(D2.USER + index) }, 1, { seconds = 20 })
			D2.send(a, decl, { amount = 1 }, D2.id(D2.WALL, `s{index}`), D2.USER + index)
		end
		backend:advance(0.2)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(2)
		spec.eq(handle.value, "granted", "the receipt save took a slot the ordinary work could not")
	end,
	["rule 63 a save that cannot land returns NotProcessedYet at RECEIPT_SAVE_TIMEOUT_SECONDS and the id saves later"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		backend:fail("transient", { server = a.id }, 1000)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(a.limits.RECEIPT_SAVE_TIMEOUT_SECONDS - 0.5)
		spec.eq(handle.done, false, "still waiting before the timeout")
		backend:advance(1)
		spec.eq(handle.value, "notYet", "NotProcessedYet at the timeout")
		spec.list(D2.session(a, pa).receipts, { "R1" }, "the id stays staged with its grant")
		spec.eq(D2.session(a, pa).value.gems, 25, "the grant stays in memory")
		spec.eq(#D2.stored(backend).receipts, 0, "nothing is stored yet")
		for _, plan in backend.plans do
			plan.remaining = 0
		end
		backend:advance(30)
		spec.list(D2.stored(backend).receipts, { "R1" }, "the staged id saved later")
		local again = D2.purchase(a, D2.info("R1"))
		spec.eq(again.value, "granted", "the redelivery is acknowledged")
		spec.eq(#route.calls, 1, "without a second grant")
	end,
