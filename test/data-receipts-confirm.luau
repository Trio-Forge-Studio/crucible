local spec = require("./lib/load")
local D2 = require("./lib/data-d2")

local PRODUCT = D2.PRODUCT

local function save(realm, player, timeout)
	return realm.run(function()
		return realm.store:save(player, timeout)
	end)
end

local function untilDone(backend, handle, limit)
	local waited = 0
	while not handle.done and waited < (limit or 300) do
		backend:advance(0.05)
		waited += 0.05
	end
end

return {
	["rule 61 afterGrant effects run once each, on fresh threads, after the confirmed save and before the callback returns"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local order = {}
		local threads = {}
		local durable = {}
		D2.route(a, PRODUCT, 25, {
			during = function(_, _, _, afterGrant)
				afterGrant(function()
					table.insert(order, "first")
					threads.first = coroutine.running()
					durable.first = D2.session(a, pa).durable.R1
				end)
				afterGrant(function()
					table.insert(order, "second")
					threads.second = coroutine.running()
				end)
			end,
		})
		local gate = backend:gate("commit", { server = a.id })
		local caller
		local result
		a.run(function()
			caller = coroutine.running()
			result = a.receipts:process(D2.info("R1"))
			table.insert(order, "returned")
		end)
		backend:advance(5)
		spec.list(order, {}, "no effect runs while the save is unconfirmed")
		gate.release()
		backend:advance(1)
		spec.list(order, { "first", "second", "returned" }, "each effect once, before the callback returns")
		spec.eq(result, "granted", "granted")
		spec.eq(durable.first, true, "the id was durable when the effect ran")
		assert(
			threads.first ~= caller and threads.second ~= caller and threads.first ~= threads.second,
			"fresh threads"
		)
		backend:advance(60)
		spec.list(order, { "first", "second", "returned" }, "and never again")
		local repeated = D2.purchase(a, D2.info("R1"))
		spec.eq(repeated.value, "granted", "a repeat callback is acknowledged")
		spec.eq(#order, 3, "without running the effects again")
	end,
	["rule 61 no effect runs for an id that was already durable or whose grant never ran"] = function()
		local backend, a, b = D2.world(2)
		local effects = { a = 0, b = 0 }
		D2.route(a, PRODUCT, 25, {
			during = function(_, _, _, afterGrant)
				afterGrant(function()
					effects.a += 1
				end)
			end,
		})
		D2.route(b, PRODUCT, 25, {
			during = function(_, _, _, afterGrant)
				afterGrant(function()
					effects.b += 1
				end)
			end,
		})
		local pa = D2.join(backend, a)
		local first = D2.purchase(a, D2.info("R1"))
		backend:advance(1)
		spec.eq(first.value, "granted", "granted on A")
		spec.eq(effects.a, 1, "A's effect ran once")
		local again = D2.purchase(a, D2.info("R1"))
		spec.eq(again.value, "granted", "a repeat on A")
		a.leave(pa)
		a.run(function()
			a.store:leave(pa)
		end)
