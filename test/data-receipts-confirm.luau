	["rule 63 K3 an ambiguous commit, a grant, a retry finding already, then a crash never acknowledges the receipt"] = function()
		local backend, a, b = D2.world(2)
		local pa = D2.join(backend, a)
		local routeA = D2.route(a, PRODUCT, 25)
		D2.set(a, pa, function()
			return { coins = 5, gems = 0 }
		end)
		backend:fail("committed", { server = a.id }, 1)
		save(a, pa, 0)
		backend:advance(0.1)
		local retry = backend:gate("transform", { server = a.id })
		backend:advance(1)
		local session = D2.session(a, pa)
		local handle = D2.purchase(a, D2.info("R"))
		local nextOp = backend:gate("transform", { server = a.id })
		spec.eq(session.revision, 2, "the grant is revision 2 with R staged")
		retry.release()
		backend:advance(0.5)
		spec.eq(session.confirmed, 1, "the already confirmed only what it found")
		spec.eq(session.durable.R, nil, "R is not durable")
		spec.eq(handle.done, false, "the callback keeps waiting")
		assert(#nextOp.parked == 1, "the next operation carries R and has not committed")
		a.crash()
		local envelope = D2.stored(backend)
		spec.eq(envelope.commit.revision, 1, "disk holds revision 1")
		spec.eq(#envelope.receipts, 0, "disk holds no R")
		spec.eq(handle.done, false, "the callback never returned PurchaseGranted")
		local pb = b.join(D2.USER)
		local loading = b.run(function()
			return b.store:load(pb, "join")
		end)
		local routeB = D2.route(b, PRODUCT, 25)
		local redelivered = D2.purchase(b, D2.info("R"))
		untilDone(backend, redelivered, 300)
		spec.eq(loading.value, true, "B loaded after A's lease lapsed")
		spec.eq(redelivered.value, "granted", "the redelivery is granted")
		spec.eq(#routeB.calls, 1, "the grant ran once on B")
		spec.eq(#routeA.calls, 1, "and once on A")
		local final = D2.stored(backend)
		spec.eq(final.commit.token, D2.session(b, pb).token, "acknowledged by B's own write")
		spec.eq(final.payload.coins, 5, "on A's revision 1")
		spec.eq(final.payload.gems, 25, "granted once")
		spec.list(final.receipts, { "R" }, "R is stored")
	end,
	["rule 64 a crash after the commit leaves the id on disk, so the redelivery is acknowledged without a grant"] = function()
		local backend, a, b = D2.world(2)
		D2.join(backend, a)
		D2.route(a, PRODUCT, 25)
		backend:gate("response", { server = a.id })
		local first = D2.purchase(a, D2.info("R1"))
		backend:advance(0.5)
		spec.eq(first.done, false, "the response is parked")
		spec.list(D2.stored(backend).receipts, { "R1" }, "R1 committed")
		a.crash()
		local pb = b.join(D2.USER)
		local loading = b.run(function()
			return b.store:load(pb, "join")
		end)
		local routeB = D2.route(b, PRODUCT, 25)
		local known = D2.purchase(b, D2.info("R1"))
		local fresh = D2.purchase(b, D2.info("R2"))
		untilDone(backend, fresh, 300)
		spec.eq(loading.value, true, "B loaded")
		spec.eq(known.value, "granted", "R1 is acknowledged")
		spec.eq(fresh.value, "granted", "R2 never committed anywhere, so it is granted")
		spec.list(routeB.calls, { "R2" }, "only R2 ran a grant")
		local envelope = D2.stored(backend)
		spec.list(envelope.receipts, { "R1", "R2" }, "both ids are stored")
		spec.eq(envelope.payload.gems, 50, "each product was granted once")
	end,
	["rule 109 K2 a purchase before the load is held and acknowledged once the load completes (durable id)"] = function()
		local backend, a = D2.world()
		D2.seed(backend, nil, { payload = { coins = 0, gems = 25 }, receipts = { "R4" } })
		local route = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("transform", { server = a.id })
		local player = a.join(D2.USER)
		a.run(function()
			return a.store:load(player, "join")
		end)
		backend:advance(0.3)
		local handle = D2.purchase(a, D2.info("R4"))
		spec.eq(handle.done, false, "held while the session loads")
		spec.eq(#route.calls, 0, "nothing grants against defaults")
		backend:advance(0.7)
		gate.release()
		backend:advance(0.5)
		spec.eq(handle.value, "granted", "R4 is durable, so PurchaseGranted with no grant")
		spec.eq(#route.calls, 0, "no grant ran")
		spec.eq(D2.stored(backend).payload.gems, 25, "gems unchanged")
	end,
	["rule 109 K2 variant R5 a held purchase that was never stored grants once after the load"] = function()
		local backend, a = D2.world()
		D2.seed(backend, nil, { payload = { coins = 3, gems = 0 } })
		local route = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("transform", { server = a.id })
		local player = a.join(D2.USER)
		a.run(function()
			return a.store:load(player, "join")
		end)
		local handle = D2.purchase(a, D2.info("R5"))
		backend:advance(1)
		gate.release()
		backend:advance(0.05)
		spec.eq(handle.done, false, "not acknowledged before the save")
		backend:advance(1)
		spec.eq(handle.value, "granted", "granted after the save")
		spec.list(route.calls, { "R5" }, "the grant ran once")
		local envelope = D2.stored(backend)
		spec.eq(envelope.payload.coins, 3, "on the stored data")
		spec.eq(envelope.payload.gems, 25, "with the grant")
