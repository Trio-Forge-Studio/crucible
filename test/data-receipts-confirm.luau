	["rule 109 K2 variant a load that waits out a crashed lease wakes the held purchase inside its bound"] = function()
		local backend, a, b = D2.world(2)
		local pa = D2.join(backend, a)
		D2.set(a, pa, function()
			return { coins = 9, gems = 0 }
		end)
		save(a, pa, 5)
		backend:advance(1)
		a.crash()
		local start = backend.now
		local route = D2.route(b, PRODUCT, 25)
		local pb = b.join(D2.USER)
		local loading = b.run(function()
			return b.store:load(pb, "join")
		end)
		local handle = D2.purchase(b, D2.info("R4"))
		untilDone(backend, handle, 300)
		spec.eq(loading.value, true, "B took the lease")
		spec.eq(handle.value, "granted", "the purchase was granted")
		local elapsed = backend.now - start
		assert(elapsed > 90 and elapsed < b.limits.LOAD_DEADLINE_SECONDS, `inside the 120 s bound, after {elapsed} s`)
		spec.list(route.calls, { "R4" }, "granted once")
		spec.eq(D2.stored(backend).payload.coins, 9, "on A's last save")
	end,
}
