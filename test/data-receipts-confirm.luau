	["rule 62 a new id is refused before its grant at the id count, and known ids are still acknowledged"] = function()
		local backend, a = D2.world()
		local seeded = {}
		for index = 1, 8191 do
			seeded[index] = `p{index}`
		end
		D2.seed(backend, nil, { receipts = seeded })
		D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local last = D2.purchase(a, D2.info("last"))
		backend:advance(1)
		spec.eq(last.value, "granted", "the 8,192nd id fits")
		spec.eq(#route.calls, 1, "its grant ran")
		local refused = D2.purchase(a, D2.info("over"))
		spec.eq(refused.value, "notYet", "the 8,193rd is refused at once")
		spec.eq(#route.calls, 1, "before its grant ran")
