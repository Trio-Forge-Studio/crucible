local spec = require("./lib/load")
local D2 = require("./lib/data-d2")

local PRODUCT = D2.PRODUCT

local world = D2.sweepWorld
local sleep = D2.sleep
local untilDone = D2.untilDone

return {
	["rule 109 shutdown a purchase during shutdown is acknowledged once saved, and the next purchase waits for the next server"] = function()
		local target
		local backend, a, b = world(function(realm)
			sleep(realm, 1.1)
			realm.store:write(target, function()
				return { coins = 77, gems = 25 }
			end)
		end, 2)
		target = D2.join(backend, a)
		local routeA = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("commit", { server = a.id })
		local first = D2.purchase(a, D2.info("R1"))
		backend:advance(0.1)
		local start = backend.now
		a.close()
		backend:advance(0.1)
		spec.eq(first.done, false, "R1's save is still in flight when the sweep starts")
		local second = D2.purchase(a, D2.info("R2"))
		spec.eq(second.value, "notYet", "receipts are closed: R2 returns NotProcessedYet at once")
		spec.list(routeA.calls, { "R1" }, "no grant ran for R2")
		gate.release()
		backend:advance(0.5)
		spec.eq(first.value, "granted", "R1's in-flight save committed and R1 is acknowledged")
		backend:advance(10)
		local envelope = D2.stored(backend)
		spec.eq(envelope.lease, nil, "the final phase released the lease")
		spec.eq(envelope.payload.coins, 77, "the game hook's write was accepted in the open phase")
		spec.list(envelope.receipts, { "R1" }, "R1 is stored and R2 is not")
		assert(backend.now - start < 28, "inside the sweep")
		local pb = D2.join(backend, b)
		local routeB = D2.route(b, PRODUCT, 25)
		local again = D2.purchase(b, D2.info("R1"))
		local redelivered = D2.purchase(b, D2.info("R2"))
		backend:advance(1)
		spec.eq(again.value, "granted", "R1 is durable on the next server")
		spec.eq(redelivered.value, "granted", "R2 is granted once there")
		spec.list(routeB.calls, { "R2" }, "only R2 ran a grant")
		spec.list(D2.stored(backend).receipts, { "R1", "R2" }, "both are stored")
		assert(pb ~= nil, "the buyer was present")
	end,
	["rule 109 shutdown a held receipt is woken at hook start and returns NotProcessedYet"] = function()
		local backend, a = world(nil)
		local route = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("transform", { server = a.id })
		local player = a.join(D2.USER)
		a.run(function()
			return a.store:load(player, "join")
		end)
		local returned
		a.run(function()
			local result = a.receipts:process(D2.info("R1"))
			returned = { result = result, at = a.clock() }
		end)
		backend:advance(5)
		spec.eq(returned, nil, "held while the load is slow")
		local start = a.clock()
		a.close()
		backend:advance(0.05)
		assert(returned ~= nil, "woken by the hook")
		spec.eq(returned.result, "notYet", "NotProcessedYet")
		assert(returned.at - start < 0.05, "at hook start")
		spec.eq(#route.calls, 0, "nothing was granted")
		gate.release()
		backend:advance(3)
		spec.eq(#route.calls, 0, "and nothing was granted after the load either")
	end,
	["rule 109 shutdown an in-flight receipt at the cutoff returns NotProcessedYet at settleAt (save never landed)"] = function()
		local backend, a, b = world(function(realm)
			sleep(realm, 40)
		end, 2)
		local pa = D2.join(backend, a)
		D2.route(a, PRODUCT, 25)
		local returned
		backend:advance(30)
		backend:gate("transform", { server = a.id })
		a.run(function()
			returned = { result = a.receipts:process(D2.info("R3")), at = a.clock() }
		end)
		backend:advance(0.1)
		local start = a.clock()
		a.close()
		backend:advance(27.3)
		spec.eq(returned, nil, "still waiting just before settleAt (27.5)")
		backend:advance(0.4)
		assert(returned ~= nil, "settled")
		spec.eq(returned.result, "notYet", "NotProcessedYet unless confirmed")
		local late = returned.at - start - 27.5
		assert(late >= -0.01 and late < 0.3, `returned at settleAt, {late} s off`)
		spec.eq(#D2.stored(backend).receipts, 0, "R3 never reached the disk")
		assert(pa ~= nil, "present")
		local pb = D2.joinSlow(backend, b)
		local routeB = D2.route(b, PRODUCT, 25)
		local fresh = D2.purchase(b, D2.info("R3"))
		untilDone(backend, fresh, 300)
		spec.eq(fresh.value, "granted", "the next server grants R3")
		spec.list(routeB.calls, { "R3" }, "once")
		assert(pb ~= nil, "present")
	end,
	["rule 109 shutdown an in-flight receipt whose save committed is acknowledged without a grant by the next server"] = function()
		local backend, a, b = world(function(realm)
			sleep(realm, 40)
		end, 2)
		D2.join(backend, a)
		D2.route(a, PRODUCT, 25)
		local returned
		backend:advance(30)
		backend:gate("response", { server = a.id })
		a.run(function()
			returned = { result = a.receipts:process(D2.info("R3")), at = a.clock() }
		end)
		backend:advance(0.1)
		local start = a.clock()
		a.close()
		backend:advance(27.8)
		assert(returned ~= nil, "settled")
		spec.eq(returned.result, "notYet", "never confirmed, so NotProcessedYet")
		assert(returned.at - start >= 27.4, "not before settleAt")
		spec.list(D2.stored(backend).receipts, { "R3" }, "the save did commit")
		D2.joinSlow(backend, b)
		local routeB = D2.route(b, PRODUCT, 25)
		local redelivered = D2.purchase(b, D2.info("R3"))
		untilDone(backend, redelivered, 300)
		spec.eq(redelivered.value, "granted", "acknowledged on the next server")
		spec.eq(#routeB.calls, 0, "without a grant")
		spec.eq(D2.stored(backend).payload.gems, 25, "granted once in all")
	end,
	["rule 109 shutdown a receipt held before the load starts is woken at hook start and returns NotProcessedYet"] = function()
		local backend, a = world(nil)
		local route = D2.route(a, PRODUCT, 25)
		a.join(D2.USER)
		local returned
		a.run(function()
			returned = { result = a.receipts:process(D2.info("R1")), at = a.clock() }
		end)
		backend:advance(5)
		spec.eq(returned, nil, "held while no load has started")
		local start = a.clock()
		a.close()
		backend:advance(0.05)
		assert(returned ~= nil, "woken by the hook")
		spec.eq(returned.result, "notYet", "NotProcessedYet")
		assert(returned.at - start < 0.05, "at hook start")
		spec.eq(#route.calls, 0, "nothing was granted")
	end,
	["rule 107 retirement wakes held callbacks and ends the wait of a granting one"] = function()
		local backend, a = D2.world()
		local route = D2.route(a, PRODUCT, 25)
		a.join(D2.USER)
		local held = D2.purchase(a, D2.info("R1"))
		backend:advance(5)
		spec.eq(held.done, false, "held")
		local other = a.join(D2.USER + 1)
		D2.seed(backend, D2.USER + 1, {})
		a.run(function()
			return a.store:load(other, "join")
		end)
		backend:advance(0.5)
		local gate = backend:gate("commit", { server = a.id })
		local granting = D2.purchase(a, D2.info("R2", PRODUCT, D2.USER + 1))
		backend:advance(1)
		spec.eq(granting.done, false, "the granting callback waits for its save")
		a.data:retire()
		backend:advance(0.05)
		spec.eq(held.value, "notYet", "the held callback woke with NotProcessedYet")
		spec.eq(granting.value, "notYet", "the granting callback ended unconfirmed")
		gate.release()
		backend:advance(1)
		spec.eq(#route.calls, 1, "only the second purchase ever ran a grant")
	end,
}
