local spec = require("./lib/load")
local D2 = require("./lib/data-d2")

local PRODUCT = D2.PRODUCT
local ENUM = { ProductPurchaseDecision = { PurchaseGranted = "GRANTED", NotProcessedYet = "NOTYET" } }

local function load(realm, player)
	return realm.run(function()
		return realm.store:load(player, "join")
	end)
end

-- A route whose grant behaves as `mode.kind` says, so one session can refuse a grant and then accept it.
local function modal(realm, gems)
	local mode = { kind = "ok", calls = 0, effects = 0 }
	realm.receipts:route(PRODUCT, {
		runtime = realm.store,
		grant = function(_, data, _, afterGrant)
			mode.calls += 1
			afterGrant(function()
				mode.effects += 1
			end)
			if mode.kind == "throw" then
				error("grant failed")
			elseif mode.kind == "yield" then
				coroutine.yield()
			elseif mode.kind == "string" then
				return "not a record"
			elseif mode.kind == "huge" then
				return { coins = string.rep("x", 262145), gems = 0 }
			end
			local value = table.clone(data)
			value.gems += gems
			return value
		end,
	})
	return mode
end

return {
	["rule 57 install sets ProcessReceipt and retirement sets a handler that returns NotProcessedYet"] = function()
		local backend, a = D2.world(1, { env = { Enum = ENUM } })
		D2.join(backend, a)
		D2.route(a, PRODUCT, 25)
		local service = {}
		a.receipts:install(service)
		local installed = service.ProcessReceipt
		spec.eq(type(installed), "function", "ProcessReceipt is set")
		local first = a.run(function()
			return service.ProcessReceipt(D2.info("R1"))
		end)
		backend:advance(1)
		spec.eq(first.value, "GRANTED", "the router grants through the installed callback")
		a.data:retire()
		assert(service.ProcessReceipt ~= installed, "retirement replaces the callback")
		local second = a.run(function()
			return service.ProcessReceipt(D2.info("R2"))
		end)
		spec.eq(second.value, "NOTYET", "the retired callback returns NotProcessedYet at once")
		local third = a.run(function()
			return installed(D2.info("R3"))
		end)
		spec.eq(third.value, "NOTYET", "and so does the old router, which is closed")
	end,
	["rule 58 refuses at once an unknown product, a bad purchase id, an absent buyer, a sealed session and closed receipts"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local function refused(info, label)
			local handle = D2.purchase(a, info)
			spec.eq(handle.value, "notYet", label)
		end
		refused(D2.info("R1", 99), "an unknown product")
		refused(D2.info("R1", 99), "an unknown product again")
		spec.eq(a.engine.logged("product 99"), 1, "an unknown product is diagnosed once per product")
		refused(D2.info(""), "an empty purchase id")
		refused(D2.info(string.rep("x", 65)), "a purchase id over 64 bytes")
		refused(D2.info(5), "a purchase id that is not a string")
		refused(D2.info("R1", PRODUCT, 777), "an absent buyer")
		spec.eq(#route.calls, 0, "no grant ran")
		spec.eq(D2.session(a, pa).revision, 0, "nothing changed")
		a.receipts:close()
		refused(D2.info("R2"), "closed receipts")
		local b, c = D2.world()
		local pc = D2.join(b, c)
		local other = D2.route(c, PRODUCT, 25)
		local session = D2.session(c, pc)
		c.store:seal(session, "authority")
		local handle = D2.purchase(c, D2.info("R3"))
		spec.eq(handle.value, "notYet", "a session sealed on losing authority")
		spec.eq(#other.calls, 0, "and no grant ran there either")
	end,
	["rule 58 a purchase id of exactly 64 bytes is accepted"] = function()
		local backend, a = D2.world()
		D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local id = string.rep("x", 64)
		local handle = D2.purchase(a, D2.info(id))
		backend:advance(1)
		spec.eq(handle.value, "granted", "64 bytes is the longest valid id")
		spec.eq(route.calls[1], id, "granted with the whole id")
	end,
	["rule 58 a purchase before the load starts is held and granted on the loaded data"] = function()
		local backend, a = D2.world()
		D2.seed(backend, nil, { payload = { coins = 7, gems = 0 } })
		local route = D2.route(a, PRODUCT, 25)
		local player = a.join(D2.USER)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(30)
		spec.eq(handle.done, false, "held while no load has started")
		spec.eq(#route.calls, 0, "no grant ran")
		load(a, player)
		backend:advance(1)
		spec.eq(handle.value, "granted", "granted once the load completed")
		local envelope = D2.stored(backend)
		spec.eq(envelope.payload.coins, 7, "on the loaded data, never on defaults")
		spec.eq(envelope.payload.gems, 25, "with the grant")
		spec.list(envelope.receipts, { "R1" }, "and its id")
		spec.eq(#route.calls, 1, "the grant ran once")
	end,
	["rule 58 a purchase while the profile loads is held until it is writable"] = function()
		local backend, a = D2.world()
		D2.seed(backend, nil, { payload = { coins = 7, gems = 0 } })
		local route = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("transform", { server = a.id })
		local player = a.join(D2.USER)
		load(a, player)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(60)
		spec.eq(handle.done, false, "held through a slow load")
		spec.eq(#route.calls, 0, "never granted against defaults")
		gate.release()
		backend:advance(1)
		spec.eq(handle.value, "granted", "granted when the load completes")
		spec.eq(D2.stored(backend).payload.coins, 7, "on the stored data")
	end,
	["rule 58 a purchase during a handoff that resumes is held and granted by the resumed session"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		D2.set(a, pa, function()
			return { coins = 5, gems = 0 }
		end)
		local old = D2.session(a, pa)
		local handoff = a.run(function()
			return a.store:handoff(pa)
		end)
		backend:advance(1)
		spec.eq(handoff.value, "ok", "handed off")
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(10)
		spec.eq(handle.done, false, "held while the handoff has sealed the session")
		spec.eq(#route.calls, 0, "no grant ran on the sealed session")
		local resumed = a.run(function()
			return a.store:resume(pa)
		end)
		backend:advance(1)
		spec.eq(resumed.value, true, "resumed")
		spec.eq(handle.value, "granted", "granted by the new session")
		local current = D2.session(a, pa)
		assert(current ~= old and current.token ~= old.token, "on a fresh token")
		local envelope = D2.stored(backend)
		spec.eq(envelope.payload.coins, 5, "on the sealed snapshot")
		spec.eq(envelope.payload.gems, 25, "with the grant")
		spec.list(envelope.receipts, { "R1" }, "and its id")
		spec.eq(#route.calls, 1, "once")
	end,
	["rule 58 a held purchase whose load fails returns NotProcessedYet"] = function()
		local backend, a = D2.world()
		local route = D2.route(a, PRODUCT, 25)
		backend:fail("reject", { server = a.id }, 1, { code = 403 })
		local player = a.join(D2.USER)
		load(a, player)
		local handle = D2.purchase(a, D2.info("R1"))
		spec.eq(handle.done, false, "held while the load is in flight")
		backend:advance(0.5)
		spec.eq(a.kicked(player), a.limits.LOAD_FAILED_MESSAGE, "the player was kicked")
		spec.eq(handle.value, "notYet", "the held purchase returns NotProcessedYet")
		spec.eq(#route.calls, 0, "nothing was granted")
		spec.eq(D2.stored(backend), nil, "nothing was stored")
	end,
	["rule 58 a held purchase whose player leaves returns NotProcessedYet"] = function()
		local backend, a = D2.world()
		local route = D2.route(a, PRODUCT, 25)
		local player = a.join(D2.USER)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(5)
		spec.eq(handle.done, false, "held")
		a.leave(player)
		a.run(function()
			a.store:leave(player)
		end)
		backend:advance(0.1)
		spec.eq(handle.value, "notYet", "woken by the departure")
		spec.eq(#route.calls, 0, "nothing was granted")
	end,
	["rule 58 a held purchase gives up LOAD_DEADLINE_SECONDS after it arrived"] = function()
		local backend, a = D2.world()
		local route = D2.route(a, PRODUCT, 25)
		a.join(D2.USER)
		local waits = D2.purchase(a, D2.info("R1"))
		backend:advance(a.limits.LOAD_DEADLINE_SECONDS - 0.1)
		spec.eq(waits.done, false, "still held just before the deadline")
		backend:advance(0.2)
		spec.eq(waits.value, "notYet", "NotProcessedYet at the deadline")
		spec.eq(#route.calls, 0, "never granted")
	end,
	["rule 58 a woken purchase starts again and rechecks its product"] = function()
		local backend, a = D2.world()
		local route = D2.route(a, PRODUCT, 25)
		local player = a.join(D2.USER)
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(5)
		a.receipts:unroute(PRODUCT)
		load(a, player)
		backend:advance(1)
		spec.eq(handle.value, "notYet", "the retired product is refused when the purchase wakes")
		spec.eq(#route.calls, 0, "no grant ran")
	end,
	["rule 59 concurrent callbacks for one purchase id share one grant and one revision"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local first = D2.purchase(a, D2.info("R1"))
		local second = D2.purchase(a, D2.info("R1"))
		backend:advance(0.05)
		local third = D2.purchase(a, D2.info("R1"))
		backend:advance(1)
		spec.eq(first.value, "granted", "first")
		spec.eq(second.value, "granted", "second shares the result")
		spec.eq(third.value, "granted", "third joins the pending save")
		spec.eq(#route.calls, 1, "the grant ran once")
		spec.eq(D2.session(a, pa).revision, 1, "one revision")
		local envelope = D2.stored(backend)
		spec.eq(envelope.payload.gems, 25, "granted once")
		spec.list(envelope.receipts, { "R1" }, "the id once")
	end,
	["rule 59 an id among the durable receipts is acknowledged without a grant"] = function()
		local backend, a = D2.world()
		D2.seed(backend, nil, { payload = { coins = 0, gems = 25 }, receipts = { "R1" } })
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local before = #backend.calls
		local handle = D2.purchase(a, D2.info("R1"))
		spec.eq(handle.value, "granted", "granted at once")
		spec.eq(#route.calls, 0, "without running the grant")
		spec.eq(D2.session(a, pa).revision, 0, "no revision")
		spec.eq(#backend.calls, before, "and no storage call")
	end,
	["rule 59 a staged id waits for its save without running the grant again"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 25)
		local gate = backend:gate("commit", { server = a.id })
		local first = D2.purchase(a, D2.info("R1"))
		backend:advance(a.limits.RECEIPT_SAVE_TIMEOUT_SECONDS + 1)
		spec.eq(first.value, "notYet", "the first callback gave up")
		spec.list(D2.session(a, pa).receipts, { "R1" }, "the id stays staged with its grant")
		local again = D2.purchase(a, D2.info("R1"))
		backend:advance(1)
		spec.eq(again.done, false, "the redelivery waits for the save")
		spec.eq(#route.calls, 1, "and does not grant again")
		gate.release()
		backend:advance(1)
		spec.eq(again.value, "granted", "granted once the save lands")
		spec.eq(#route.calls, 1, "the grant ran once in all")
		spec.eq(D2.stored(backend).payload.gems, 25, "stored once")
	end,
	["rule 59 an unchanged grant result still records the id"] = function()
		local backend, a = D2.world()
		local pa = D2.join(backend, a)
		local calls = 0
		a.receipts:route(PRODUCT, {
			runtime = a.store,
			grant = function(_, data)
				calls += 1
				return data
			end,
		})
		local handle = D2.purchase(a, D2.info("R1"))
		backend:advance(1)
		spec.eq(handle.value, "granted", "granted")
		spec.eq(D2.session(a, pa).revision, 1, "an unchanged result is still a revision")
		spec.list(D2.stored(backend).receipts, { "R1" }, "the id is stored")
		local again = D2.purchase(a, D2.info("R1"))
		spec.eq(again.value, "granted", "and a repeat is acknowledged")
		spec.eq(calls, 1, "without a second grant")
	end,
	["rule 59 an old receipt after more than 50 newer ones is still acknowledged without a grant"] = function()
		local backend, a = D2.world()
		D2.join(backend, a)
		local route = D2.route(a, PRODUCT, 1)
		local old = D2.purchase(a, D2.info("OLD"))
		backend:advance(0.5)
		spec.eq(old.value, "granted", "the old purchase was granted")
		for index = 1, 60 do
			local handle = D2.purchase(a, D2.info(`N{index}`))
			backend:advance(0.5)
			spec.eq(handle.value, "granted", `purchase {index}`)
		end
		spec.eq(#route.calls, 61, "61 grants so far")
		local replay = D2.purchase(a, D2.info("OLD"))
		spec.eq(replay.value, "granted", "the old receipt is acknowledged")
		spec.eq(#route.calls, 61, "without granting twice")
		local envelope = D2.stored(backend)
		spec.eq(#envelope.receipts, 61, "nothing was evicted")
		spec.eq(envelope.receipts[1], "OLD", "the oldest id is still there")
		spec.eq(envelope.payload.gems, 61, "granted once each")
	end,
	["rule 60 a grant that throws, yields or returns an invalid value stores nothing"] = function()
		for _, kind in { "throw", "yield", "string", "huge" } do
			local backend, a = D2.world()
			local pa = D2.join(backend, a)
			local mode = modal(a, 25)
			local session = D2.session(a, pa)
			local value = session.value
			local before = #backend.calls
			mode.kind = kind
			local handle = D2.purchase(a, D2.info("R1"))
			backend:advance(0.3)
			spec.eq(#backend.calls, before, `{kind}: no save was requested`)
			backend:advance(15)
			spec.eq(handle.value, "notYet", `{kind}: NotProcessedYet`)
			spec.eq(mode.calls, 1, `{kind}: the grant ran`)
			spec.eq(session.value, value, `{kind}: the data is untouched`)
			spec.eq(#session.receipts, 0, `{kind}: the id is not staged`)
			spec.eq(session.revision, 0, `{kind}: no revision`)
			spec.eq(mode.effects, 0, `{kind}: no effect ran`)
			local envelope = D2.stored(backend)
			spec.eq(#envelope.receipts, 0, `{kind}: the id is not stored`)
			spec.eq(envelope.payload.gems, 0, `{kind}: the data is not stored`)
			mode.kind = "ok"
			local retry = D2.purchase(a, D2.info("R1"))
			backend:advance(1)
			spec.eq(retry.value, "granted", `{kind}: the same id grants once the grant works`)
			spec.eq(D2.stored(backend).payload.gems, 25, `{kind}: and stores it`)
		end
	end,
}
