{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		// The Roblox declarations reference the upstream compiler types by name. This project supplies its TS7 fork.
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["@trioforge/compiler-types", "@rbxts/types"]
	}
}
