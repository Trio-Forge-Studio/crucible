{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		// @rbxts/types references @rbxts/compiler-types by name, so the upstream copy loads beside this fork, and
		// library checking reports their duplicate declarations.
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["@trioforge/compiler-types", "@rbxts/types"]
	}
}
